# AI4SE Coding Agent Harness — 环境变量模板
# 用法：cp .env.example .env，按需填写，切勿提交 .env。
# 威胁模型：.env 为明文且 process-env 可见；API Key 明文不落 .env，
# 生产环境经主密码 AES-256-GCM 加密后存于 ~/.ai4se/creds.enc（见 WebUI「保存 Key」）。
# 下列 API_KEY 仅作首次写入 / 测试回退用的空值模板。

# ───────── 凭据 ─────────
# API Key（生产运行时不读 env，见上；测试在无 creds.enc 时回退读此值）
API_KEY=
# 解锁加密凭据的主密码（process-env 可见，建议仅本地/CI 临时设置）
MASTER_PASSWORD=

# ───────── LLM 端点（非密，可由 WebUI 配置文件覆盖）─────────
# OpenAI 兼容端点，含 /v1，如 https://api.openai.com/v1
API_BASE_URL=
# 模型名，如 gpt-4o-mini
MODEL=
# 可选：单次 LLM 请求硬超时毫秒（0/留空=不启用）。连接挂死时及时中断重试，
# 避免吞掉整轮预算；真实 LLM 集成测试排队抖动时可设 LLM_TIMEOUT_MS=90000
LLM_TIMEOUT_MS=

# ───────── Web 控制面板 ─────────
# 监听端口，留空则使用默认 8080
PORT=
