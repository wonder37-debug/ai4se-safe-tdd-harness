# AI4SE SafeFix — 环境变量模板
# 用法：cp .env.example .env，按需填写，切勿提交 .env。
# 威胁模型：.env 为明文且 process-env 可见；长期密钥请用加密存储：
#   uv run safefix creds set  →  ~/.safefix/creds.enc（AES-256-GCM，主密码解锁）
# real 模式缺凭据会显式报错，绝不静默降级演示。

# ───────── 凭据 ─────────
# API Key（明文兜底，带告警；优先用 safefix creds 加密存储）
API_KEY=
# 解锁加密凭据的主密码（process-env 可见，建议仅本地/CI 临时设置）
MASTER_PASSWORD=

# ───────── LLM 端点（非密）─────────
# OpenAI 兼容端点，含 /v1，如 https://api.openai.com/v1
API_BASE_URL=
# 模型名，如 gpt-4o-mini
MODEL=
# 可选：单次 LLM 请求硬超时秒（0/留空=不启用）
LLM_TIMEOUT_S=
